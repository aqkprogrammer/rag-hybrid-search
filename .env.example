# Copy to .env and adjust. Every variable is optional: the defaults run fully offline
# (mock LLM, hashing embeddings, lexical reranker, embedded Chroma).

# --- Service ------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=console                 # console | json
DATA_DIR=./data
CORS_ORIGINS=["*"]                 # JSON list
MAX_UPLOAD_MB=25
# AUTO_SEED_DIR=./sample_docs      # ingest this directory at startup when the index is empty

# --- LLM ----------------------------------------------------------------------
LLM_PROVIDER=mock                  # mock | openai | anthropic
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=                 # optional (Azure/OpenAI-compatible gateways)
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_EFFORT=low             # low | medium | high | xhigh | max (unset = model default)
LLM_MAX_TOKENS=8192
LLM_TIMEOUT_S=120

# --- Embeddings -----------------------------------------------------------------
EMBEDDING_PROVIDER=hashing         # hashing | sentence-transformers | openai
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
HASHING_DIM=768

# --- Vector store -----------------------------------------------------------------
VECTOR_STORE=chroma                # chroma | qdrant | memory
# QDRANT_URL=http://localhost:6333 # unset -> embedded local Qdrant under DATA_DIR
# QDRANT_API_KEY=

# --- Chunking ---------------------------------------------------------------------
CHUNK_SIZE_TOKENS=320
CHUNK_OVERLAP_TOKENS=48
CHUNK_MIN_TOKENS=24
TOKENIZER=tiktoken                 # tiktoken | simple

# --- Retrieval --------------------------------------------------------------------
RETRIEVAL_MODE=hybrid              # hybrid | dense | bm25
DENSE_TOP_K=30
BM25_TOP_K=30
RRF_K=60
DENSE_WEIGHT=1.0
BM25_WEIGHT=1.0
RERANK_CANDIDATES=20
FINAL_TOP_K=5
RERANKER=lexical                   # cross-encoder | lexical | none
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Citation verification --------------------------------------------------------
VERIFY_CITATIONS=true
VERIFIER_THRESHOLD=0.55
VERIFIER_LEXICAL_WEIGHT=0.5
VERIFIER_LLM_JUDGE=false
STRIP_UNSUPPORTED_CITATIONS=true
